{
  "expo": {
    "name": "Sarathi",
    "slug": "sarathi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sarathi",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0d0e11",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.pknspace.sarathi"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1a1b1f",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.pknspace.sarathi",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "CAMERA",
        "POST_NOTIFICATIONS",
        "android.permission.CAMERA",
        "REQUEST_INSTALL_PACKAGES"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#0d0e11"
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Sarathi uses the camera to scan the pairing code shown on your Mac.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#4ad496",
          "defaultChannel": "agents",
          "icon": "./assets/images/notification-icon.png"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6683aaec-edee-4a52-87bd-c15a50a5751a"
      }
    },
    "owner": "mepkn",
    "platforms": [
      "android",
      "ios"
    ]
  }
}
